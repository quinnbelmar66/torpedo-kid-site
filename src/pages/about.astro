---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/torpedo/PageIntro.astro';
import Specs from '~/components/torpedo/Specs.astro';
import WorkNow from '~/components/torpedo/WorkNow.astro';
import closeUp from '~/assets/images/torpedo/glenville-999-1903.jpg';
import { years } from '~/car';
import { photoSource } from '~/site';

const metadata = {
  title: 'About',
  description: 'How Fontys students are building a modern electric Torpedo Kid, year by year.',
};
---

<Layout metadata={metadata}>
  <PageIntro
    title="One car, built by a new team each year"
    lead="Our goal this year is to drive the Torpedo Kid on a private road. The long-term goal is Sweden."
  />

  <section class="band">
    <div class="wrap split">
      <h2 class="title">The project so far</h2>
      <ol>
        {
          years.map(([y, t]) => (
            <li>
              <span class="year">{y}</span>
              <span>{t}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band band-stone">
    <div class="wrap split">
      <h2 class="title">The car</h2>
      <div>
        <Specs />
        <p class="photo-note">
          Design targets and estimates. <a href="#work">See what each team is working on</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="band" id="work">
    <div class="wrap">
      <h2 class="title work-title">What we are working on now</h2>
      <WorkNow />
    </div>
  </section>

  <section class="band band-stone">
    <div class="wrap split">
      <h2 class="title">Safety</h2>
      <div class="copy">
        <p>
          We design to the European rules for heavy quadricycles, with a roll cage, seat belts, two separate brake
          circuits and an emergency kill switch.
        </p>
        <p>
          The battery is designed to sit in a sealed steel box. Pressing the emergency stop is designed to cut the
          high-voltage battery through a hardwired line and send a shutdown message to the rest of the car, while the
          lights stay on.
        </p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap split origin">
      <div>
        <h2 class="title">Where the shape comes from</h2>
        <div class="copy">
          <p>
            Walter Baker built two electric racers called Torpedo Kid in Cleveland in 1902. They were white, waist high
            and had one seat.
          </p>
          <p>
            <a href="https://www.torpedokid.com/">More history at torpedokid.com</a>
          </p>
        </div>
      </div>
      <figure>
        <Image
          src={closeUp}
          alt="The white 1903 Torpedo Kid, number 999, with disc wheels and only the driver's head above the body, between two open racing cars."
          widths={[640, 960, 1280]}
          sizes="(min-width: 56rem) 45vw, 92vw"
        />
        <figcaption class="photo-note">
          Walter Baker at Glenville, September 1903. <a href={photoSource}>Photo: Wikimedia Commons, public domain</a>.
        </figcaption>
      </figure>
    </div>
  </section>
</Layout>

<style>
  .work-title {
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  ol {
    display: grid;
    gap: 1.5rem;
    padding-top: 0.625rem;
  }
  li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--graphite);
  }
  li:last-child {
    color: var(--charcoal);
    font-weight: 600;
  }
  .year {
    color: var(--burgundy);
  }
  .split > div > .photo-note {
    margin-top: 1.75rem;
  }
  .origin .copy {
    margin-top: 1.5rem;
  }
  .origin img {
    width: 100%;
    height: auto;
  }
</style>
