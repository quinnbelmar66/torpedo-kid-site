---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Car from '~/components/torpedo/Car.astro';
import Specs from '~/components/torpedo/Specs.astro';
import InstagramFeed from '~/components/torpedo/InstagramFeed.astro';
import Road from '~/components/torpedo/Road.astro';
import Partners from '~/components/torpedo/Partners.astro';
import cad from '~/assets/images/torpedo/car/cad-assembly.jpg';
import { SITE } from 'astrowind:config';
import { contact } from '~/site';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'TorpedoKid: bringing an electric pioneer back to life',
  ignoreTitleTemplate: true,
};

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE?.site}/#organization`,
    name: SITE?.name,
    url: SITE?.site,
    email: contact.email,
    sameAs: [contact.instagram, contact.linkedin],
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <section class="hero">
    <div class="wrap hero-copy">
      <p class="kicker">History reimagined</p>
      <h1 class="display">Bringing an electric pioneer back to life.</h1>
      <div class="actions">
        <a class="cta" href={getPermalink('/join-us')}>Join the team</a>
        <a class="secondary" href="#about">About the project</a>
      </div>
    </div>
    <div class="road">
      <div class="roll-in">
        <div class="drive-off" style="animation-timeline: scroll(root); animation-range: 0 90vh"><Car /></div>
      </div>
    </div>
  </section>

  <section class="band mission" id="mission">
    <div class="wrap">
      <div class="split">
        <h2 class="title">Our mission</h2>
        <p class="statement">
          We combine mechanical engineering, electrical systems and modern manufacturing to recreate an early electric
          vehicle, and then drive it to Sweden.
        </p>
      </div>
    </div>
  </section>

  <section class="band band-stone" id="about">
    <div class="wrap">
      <div class="split">
        <h2 class="title">About the project</h2>
        <div class="copy">
          <p>
            We are mechanical and mechatronics engineering students at Fontys Technology. Since 2022, each year's team
            has picked up where the last one stopped, building a modern electric car in the shape of the 1902 Torpedo
            Kid.
          </p>
          <p>This year we want to drive it for the first time, on a private road. After that comes Sweden.</p>
          <p><a href={`${getPermalink('/about')}#work`}>See what each team is working on</a></p>
        </div>
      </div>
      <div class="car-now">
        <Image
          src={cad}
          alt="CAD model of our car without its body: a tube frame in three sections, four wheels and a seated driver."
          widths={[480, 640, 810]}
          sizes="(min-width: 64rem) 48vw, 92vw"
        />
        <div>
          <h3 class="sub">What we are building</h3>
          <Specs />
          <p class="photo-note">Design targets and estimates. The body is not shown.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="road-band" id="road">
    <div class="road-pin">
      <div class="wrap">
        <Road />
      </div>
    </div>
  </section>

  <section class="band instagram" id="instagram">
    <div class="wrap">
      <InstagramFeed />
    </div>
  </section>

  <section class="band band-stone partners-band" id="partners">
    <div class="wrap">
      <h2 class="title">Thank you to our partners, who made this project possible.</h2>
      <Partners />
      <a class="textlink" href={getPermalink('/partner-with-us')}>Become a partner</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    /* Scroll timelines are set inline: the CSS minifier folds animation-timeline
       into the animation shorthand, which browsers reject.
       Car width and travel are in vw so wheel rotation can be computed:
       angle = distance / wheel radius, and the radius is 112/1200 of the car. */
    --car: 66;
    --in: 100;
    --out: 60;
    --r: calc(var(--car) * 112 / 1200);
    background: var(--charcoal);
    color: var(--cream);
    overflow: hidden;
    min-height: calc(100svh - 4.5rem);
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .hero-copy {
    padding-block: clamp(2rem, 5vh, 4.5rem) 0;
  }
  .kicker {
    color: var(--light-brass);
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }
  h1 {
    max-width: 14ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }
  .secondary {
    color: var(--light-text);
    text-decoration: underline;
    text-decoration-color: var(--brass);
    text-underline-offset: 0.25em;
    padding-block: 0.75rem;
  }
  .secondary:hover {
    color: var(--cream);
  }
  .road {
    display: flex;
    justify-content: flex-end;
    padding-right: 2vw;
  }
  .roll-in {
    width: calc(var(--car) * 1vw);
    flex: none;
  }
  .road :global(.wheel-intro),
  .road :global(.wheel-scroll) {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Short screens: tuck the car up beside the headline so it stays in view. */
  @media (min-width: 48rem) and (max-height: 50rem) and (orientation: landscape) {
    .hero {
      --car: 52;
    }
    .road {
      margin-top: -9rem;
      pointer-events: none;
    }
  }

  @media (min-width: 96rem) {
    .road {
      margin-top: -5rem;
      pointer-events: none;
    }
  }

  @media (max-width: 47.99rem), (orientation: portrait) {
    .hero {
      --car: 94;
      --out: 80;
      min-height: 0;
    }
    .hero-copy {
      padding-bottom: 4rem;
    }
    .road {
      padding-right: 0;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .roll-in {
      animation: roll-in 1.9s cubic-bezier(0.16, 0.8, 0.3, 1) both;
    }
    .road :global(.wheel-intro) {
      animation: wheel-in 1.9s cubic-bezier(0.16, 0.8, 0.3, 1) both;
    }
    @supports (animation-timeline: scroll()) {
      .drive-off {
        animation: drive-off linear both;
      }
      .road :global(.wheel-scroll) {
        animation: wheel-off linear both;
      }
    }
  }
  @keyframes roll-in {
    from {
      transform: translateX(calc(var(--in) * -1vw));
    }
  }
  @keyframes wheel-in {
    from {
      transform: rotate(calc(var(--in) / var(--r) * -1rad));
    }
  }
  @keyframes drive-off {
    to {
      transform: translateX(calc(var(--out) * 1vw));
    }
  }
  @keyframes wheel-off {
    to {
      transform: rotate(calc(var(--out) / var(--r) * 1rad));
    }
  }

  .mission {
    background: var(--cream);
  }
  .mission .statement {
    text-wrap: pretty;
  }
  .car-now {
    display: grid;
    gap: 2.5rem clamp(2rem, 5vw, 5rem);
    align-items: center;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .car-now img {
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  @media (min-width: 64rem) {
    .car-now {
      grid-template-columns: 6fr 5fr;
    }
  }
  .sub {
    font-family: var(--font-besley), serif;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    letter-spacing: -0.015em;
    color: var(--charcoal);
    margin-bottom: 1.5rem;
  }
  .car-now .photo-note {
    margin-top: 1.75rem;
  }
  .road-band {
    background: var(--charcoal);
    color: var(--cream);
  }
  .road-pin {
    padding-block: var(--section);
  }
  /* Wide screens with motion: the map stays in view while scrolling drives the car. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .road-band {
      height: 260vh;
    }
    .road-pin {
      position: sticky;
      top: 4.5rem;
      min-height: calc(100svh - 4.5rem);
      display: flex;
      align-items: center;
      padding-block: 2rem;
    }
    .road-pin > .wrap {
      width: 100%;
    }
  }
  .instagram {
    background: var(--cream);
  }
  .partners-band .title {
    max-width: 22ch;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .partners-band .textlink {
    display: inline-block;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    font-size: 1.125rem;
  }
</style>
